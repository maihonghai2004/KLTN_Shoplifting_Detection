# Email configuration for alerts
# Copy this file to `.env` and fill in your real values. NEVER commit `.env`.

# Your Gmail address used to send alerts
GMAIL_USER=your-email@gmail.com

# Gmail App Password (16 chars). Create one at https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on the account.
GMAIL_APP_PASSWORD=your-app-password

# Email address that should receive the alerts
RECIPIENT_EMAIL=recipient@example.com
